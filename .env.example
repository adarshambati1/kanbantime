# Copy to .env for local development. Never commit .env.
# In production these are set in the Vercel dashboard, not in a file.

# --- Google OAuth ---------------------------------------------------------
# Create at https://console.cloud.google.com/apis/credentials
#   Application type: Web application
#   Authorised redirect URIs:
#     http://localhost:4321/api/auth/callback
#     https://todo.adarshambati.com/api/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Only these addresses may sign in. Comma-separated.
ALLOWED_EMAILS=adarsh.ambati1@gmail.com

# Signs the session cookie. Generate with: openssl rand -hex 32
# Changing it signs every device out.
AUTH_SECRET=

# --- iOS Shortcuts / Siri -------------------------------------------------
# Shortcuts can't do an OAuth flow, so they authenticate with this instead.
# Kept separate from the session so it can be rotated on its own — it lives in
# plaintext inside an iCloud-synced shortcut.
# Generate with: openssl rand -hex 32
SHORTCUTS_TOKEN=

# --- Database -------------------------------------------------------------
# Leave both blank locally: the app falls back to a SQLite file at ./data.
# In production set these from `turso db show` and `turso db tokens create`.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
