---
import App from '../layouts/App.astro';
import { COOKIE, readSession } from '../lib/auth';
import { getColumns } from '../lib/prefs';

export const prerender = false;

const email: string | null = readSession(Astro.cookies.get(COOKIE)?.value);
const columns = await getColumns();
---

<App title="Kanban Time" email={email}>
  <div class="head">
    <h1>Board</h1>
    <span id="status" class="status" aria-live="polite"></span>
  </div>

  <div class="board" id="board" data-columns={JSON.stringify(columns)}>
    {
      columns.map((col) => (
        <section class="column">
          <div class="column__head">
            <h2 class="column__label">{col.label}</h2>
            <span class="column__count" data-count={col.id} />
          </div>
          <ul class="column__list" data-column={col.id} />
          <form class="add" data-column={col.id} autocomplete="off">
            <input class="add__field" placeholder="Add card" aria-label={`Add card to ${col.label}`} />
          </form>
        </section>
      ))
    }
  </div>
</App>

<style>
  .head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .status {
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
  }

  .board {
    display: flex;
    gap: var(--space-5);
    margin-top: var(--space-6);
    overflow-x: auto;
    /* One column fills the screen on a phone, swipe/scroll between them —
       the alternative (shrinking four columns to fit) makes every one of
       them too narrow to read a title in. */
    scroll-snap-type: x mandatory;
    padding-bottom: var(--space-2);
  }

  .column {
    flex: 0 0 82vw;
    min-width: 0;
    scroll-snap-align: start;
  }

  @media (min-width: 40rem) {
    .board {
      scroll-snap-type: none;
    }
    .column {
      flex: 1 1 0;
    }
  }

  .column__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-border);
  }

  .column__label {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
  }

  .column__count {
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
  }

  .column__list {
    list-style: none;
    min-height: var(--space-6);
    padding: 0;
  }

  .add {
    margin-top: var(--space-2);
  }

  .add__field {
    width: 100%;
    padding: var(--space-2) var(--space-1);
    font-size: var(--text-sm);
    color: inherit;
    background: none;
    border: 0;
    border-bottom: 1px solid transparent;
  }

  .add__field::placeholder {
    color: var(--color-text-subtle);
  }

  .add__field:focus-visible {
    outline: none;
    border-bottom-color: var(--color-border-strong);
  }

  /* Rows are built with createElement, so Astro's scoping attribute never
     lands on them — these have to be :global, kept under .board so nothing
     leaks to the rest of the page. */
  .board :global(.card) {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg);
    touch-action: pan-y;
  }

  .board :global(.card--dragging) {
    box-shadow: none;
    border: 1px solid var(--color-border-strong);
    background: var(--color-bg-subtle);
    opacity: 0.92;
  }

  .board :global(.card--placeholder) {
    border-bottom: 1px dashed var(--color-border-strong);
  }

  .board :global(.card__handle) {
    flex: none;
    width: 1.1rem;
    text-align: center;
    color: var(--color-text-subtle);
    cursor: grab;
    opacity: 0;
    transition: opacity var(--transition);
    touch-action: none;
  }

  .board :global(.card:hover .card__handle),
  .board :global(.card__handle:focus-visible) {
    opacity: 1;
  }

  @media (hover: none) {
    .board :global(.card__handle) {
      opacity: 0.55;
    }
  }

  .board :global(.card.is-done .card__text) {
    color: var(--color-text-subtle);
    text-decoration: line-through;
  }

  .board :global(.card__text) {
    flex: 1;
    min-width: 0;
    font-size: var(--text-sm);
    word-break: break-word;
  }

  .board :global(.card__minutes) {
    flex: none;
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
  }

  .board :global(.card__check) {
    flex: none;
    width: 1.05rem;
    height: 1.05rem;
    accent-color: var(--color-text);
    cursor: pointer;
  }

  .board :global(.card__del) {
    flex: none;
    padding: var(--space-1) var(--space-2);
    font-size: var(--text-lg);
    line-height: 1;
    color: var(--color-text-subtle);
    background: none;
    border: 0;
    border-radius: var(--radius-sm);
    cursor: pointer;
    opacity: 0;
    transition: opacity var(--transition), color var(--transition);
  }

  .board :global(.card:hover .card__del),
  .board :global(.card__del:focus-visible) {
    opacity: 1;
  }

  .board :global(.card__del:hover) {
    color: var(--color-danger);
  }

  @media (hover: none) {
    .board :global(.card__del) {
      opacity: 0.55;
    }
  }
</style>

<script>
  import { listColumn, add, update, remove, move, sync, type Todo } from '../lib/store';
  import { attachDrag, type DropResult } from '../lib/board';

  interface Col {
    id: string;
    label: string;
    kind: 'kanban' | 'timetable';
  }

  const $board = document.getElementById('board') as HTMLDivElement;
  const $status = document.getElementById('status') as HTMLSpanElement;
  const columns = JSON.parse($board.dataset.columns || '[]') as Col[];

  /**
   * Runs an async UI action and surfaces failures.
   *
   * Without this, a rejected IndexedDB write (private browsing, quota
   * exceeded) becomes an unhandled rejection: the interaction appears to do
   * nothing and there's no signal anywhere the user can see.
   */
  function act(fn: () => Promise<void>): void {
    void fn().catch((error: unknown) => {
      console.error(error);
      $status.textContent = "couldn't save";
    });
  }

  function cardEl(todo: Todo): HTMLLIElement {
    const li = document.createElement('li');
    li.className = 'card';
    li.dataset.id = todo.id;
    li.dataset.rank = todo.placement.rank;
    if (todo.done) li.classList.add('is-done');

    const handle = document.createElement('span');
    handle.className = 'card__handle';
    handle.setAttribute('aria-hidden', 'true');
    handle.textContent = '⠿';

    const check = document.createElement('input');
    check.type = 'checkbox';
    check.className = 'card__check';
    check.checked = Boolean(todo.done);
    check.setAttribute('aria-label', todo.title);
    check.addEventListener('change', () => {
      act(async () => {
        await update(todo.id, { done: check.checked ? 1 : 0 });
        await renderAll();
        void flush();
      });
    });

    const text = document.createElement('span');
    text.className = 'card__text';
    text.textContent = todo.title;

    const del = document.createElement('button');
    del.type = 'button';
    del.className = 'card__del';
    del.textContent = '×';
    del.setAttribute('aria-label', `Delete ${todo.title}`);
    del.addEventListener('click', () => {
      act(async () => {
        await remove(todo.id);
        await renderAll();
        void flush();
      });
    });

    li.append(handle, check, text, del);
    return li;
  }

  async function renderColumn(col: Col): Promise<void> {
    const list = $board.querySelector<HTMLUListElement>(`.column__list[data-column="${col.id}"]`);
    const count = $board.querySelector<HTMLSpanElement>(`.column__count[data-count="${col.id}"]`);
    if (!list || !count) return;
    const cards = await listColumn(col.id);
    list.replaceChildren(...cards.map(cardEl));
    count.textContent = cards.length > 0 ? String(cards.length) : '';
  }

  async function renderAll(): Promise<void> {
    await Promise.all(columns.map((c) => renderColumn(c)));
  }

  // Sync never blocks the UI. It reports into the status line and re-renders
  // only if the server actually told us something new.
  async function flush(): Promise<void> {
    $status.textContent = 'syncing…';
    try {
      if (await sync()) await renderAll();
      $status.textContent = navigator.onLine ? '' : 'offline';
    } catch {
      $status.textContent = 'offline — saved locally';
    }
  }

  attachDrag($board, (result: DropResult) => {
    act(async () => {
      await move(result.id, { column: result.column, kind: 'kanban', before: result.before, after: result.after });
      await renderAll();
      void flush();
    });
  });

  for (const form of $board.querySelectorAll<HTMLFormElement>('.add')) {
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const input = form.querySelector<HTMLInputElement>('.add__field');
      const title = input?.value.trim();
      const column = form.dataset.column;
      if (!input || !title || !column) return;
      input.value = '';
      act(async () => {
        await add(title, column);
        await renderAll();
        void flush();
      });
    });
  }

  // Foreground sync rather than background sync: iOS is unreliable about the
  // latter, and this covers every case you'd actually notice.
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'visible') void flush();
  });
  addEventListener('online', () => void flush());
  addEventListener('pageshow', () => void flush());
  setInterval(() => {
    if (document.visibilityState === 'visible') void flush();
  }, 60_000);

  await renderAll();
  void flush();
</script>
